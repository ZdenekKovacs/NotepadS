<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sandbox on from day one (required for the Mac App Store). NSDocument handles file
	     access for files the user opens or saves; nothing else is needed for phase 1. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Printing (File › Print…). Sandboxed apps may only print with this entitlement;
	     without it macOS says "This application does not support printing". -->
	<key>com.apple.security.print</key>
	<true/>
</dict>
</plist>
